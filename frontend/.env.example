# OptiAI frontend — copy to `.env.local` and adjust if needed.
#
#   cp frontend/.env.example frontend/.env.local
#
# Everything here is optional: the defaults in the code cover a local backend
# on its standard port, so a fresh clone runs with no env file at all.

# Where the browser reaches the OptiAI backend.
#
# `NEXT_PUBLIC_` is inlined into the client bundle at build time and is visible
# to anyone who opens the page — so this may only ever hold a URL, never a key
# or a token. Defaults to http://127.0.0.1:20180 when unset.
#
# The browser talks to the backend directly rather than through a Next route,
# so that SSE streaming from /api/chat is not buffered on the way.
NEXT_PUBLIC_API_URL=http://127.0.0.1:20180
