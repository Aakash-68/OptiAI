# OptiAI backend — copy to `.env` and fill in.
#
#   cp backend/.env.example backend/.env
#
# `.env` is gitignored. Never put a real secret in this file: it is committed,
# so anything written here is public to everyone with the repo.

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=20180
HOST=127.0.0.1

# Origin allowed to call the API. Leave unset to reflect any origin (dev only).
CORS_ORIGIN=http://localhost:20181

# Base URL handed to CLI tools in generated config snippets, and the endpoint
# OptiAI compares a tool's config against when reporting "Configured" on
# Connect. Must be reachable from wherever the CLI runs.
OPTIAI_GATEWAY_URL=http://localhost:20180

# Per-request chat logging (received / routing / first token / usage / done).
# Set to 0 to silence it.
OPTIAI_CHAT_LOG=1

# ─── Storage ───────────────────────────────────────────────────────────────────
# SQLite DB + provider credentials live here. Kept separate from any existing
# 9Router install (%APPDATA%/9router) so OptiAI never mutates that data.
#
# Treat this directory as secret — it holds OAuth tokens and provider API keys
# in readable form. It is gitignored; do not copy it between machines.
DATA_DIR=./.data

# ─── Secrets ───────────────────────────────────────────────────────────────────
# Both are local-only: they sign and derive the gateway API keys OptiAI issues
# to your CLI tools (sk-<machine>-<id>-<crc>). They are NOT provider
# credentials and are never sent anywhere.
#
# Generate a value for each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Changing API_KEY_SECRET invalidates every key already issued, so every CLI
# pointed at OptiAI has to be given a new one.
API_KEY_SECRET=replace-with-a-random-32-byte-hex-string
MACHINE_ID_SALT=replace-with-a-random-32-byte-hex-string

# ─── Optional: outbound proxy ──────────────────────────────────────────────────
# Honoured when OptiAI calls a provider. Unset means direct connections.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7891
# NO_PROXY=localhost,127.0.0.1

# ─── Not configured here ───────────────────────────────────────────────────────
# Provider credentials (OAuth tokens, provider API keys) are never read from
# the environment. They are stored per-connection in the database once you
# connect a provider under Providers, so rotating one does not mean editing a
# file and restarting.
